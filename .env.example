# Optional IndexNow key (8-128 ASCII letters, digits or dashes); empty disables submissions.
INDEXNOW_KEY=

# Optional Google Indexing API key: the service account JSON as one base64 line; empty disables it.
OPENQAREER_GSC_SERVICE_ACCOUNT_B64=

# Release CI secrets only. Never commit their values.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Use `src-tauri/tauri.release.conf.json` only for a signed release build.
