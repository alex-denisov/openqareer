{
  "name": "openqareer",
  "version": "1.0.0",
  "description": "Candidate-owned local career decision workspace",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc && vite build && tsx scripts/prerender-career-shell.tsx dist/index.html && node scripts/split-browser-entry.mjs && node scripts/compress-wasm-engine.mjs && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node dist/server.mjs",
    "render-shot": "node scripts/render_html_screenshot.js",
    "shots:onboarding": "node scripts/capture-onboarding-shots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test && node scripts/verify-built-shell.mjs && node scripts/verify-intake-fits.mjs && node scripts/verify-wizard-source-step.mjs",
    "test:e2e:smoke": "playwright test",
    "test:e2e:built-shell": "node scripts/verify-built-shell.mjs",
    "lint": "eslint . --max-warnings=0 && npm run format:check",
    "lint:fix": "eslint . --fix && npm run format",
    "format:check": "prettier --check package.json eslint.config.mjs playwright.config.ts e2e scripts/render_html_screenshot.js",
    "format": "prettier --write package.json eslint.config.mjs playwright.config.ts e2e scripts/render_html_screenshot.js",
    "check:agents": "node scripts/check-agent-contract.mjs",
    "verify:hh-test-account": "tsx scripts/verify-hh-test-account.ts",
    "security:history": "gitleaks detect --no-banner --redact -c .gitleaks.toml -s .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "test:e2e:intake-fits": "node scripts/verify-intake-fits.mjs",
    "test:e2e:wizard-source-step": "node scripts/verify-wizard-source-step.mjs",
    "verify:hh-session-import": "tsx scripts/verify-hh-session-import.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@firecrawl/pdf-inspector-wasm": "^0.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "fastify": "^5.11.0",
    "fflate": "^0.8.3",
    "openai": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.6"
  }
}
