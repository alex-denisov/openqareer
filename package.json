{
  "name": "openqareer",
  "version": "1.0.0",
  "description": "Candidate-owned local career decision workspace",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc && vite build && node scripts/split-browser-entry.mjs && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node dist/server.mjs",
    "render-shot": "node scripts/render_html_screenshot.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.11.0",
    "openai": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.6"
  }
}
