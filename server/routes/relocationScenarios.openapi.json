          },
          "expenses": {
            "type": "object",
            "properties": {
              "rent": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "utilities": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "food": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "transport": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "insurance": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "education": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "other": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              }
            },
            "additionalProperties": false
          },
          "upfront": {
            "type": "object",
            "properties": {
              "visa": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "moving": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "deposit": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "documents": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "travel": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              },
              "furnishings": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
              }
            },
            "additionalProperties": false
          },
          "reserveMonths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36
          },
          "proofOfFunds": {
            "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
          },
          "comparisonRate": {
            "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
          },
          "proofFundsUsableForLiving": {
            "default": false,
            "type": "boolean"
          },
          "payrollOptions": {
            "type": "object",
