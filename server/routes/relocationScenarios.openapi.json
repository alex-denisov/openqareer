                  },
                  "germanLevel": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "none",
                          "A1",
                          "A2",
                          "B1",
                          "B2",
                          "C1",
                          "C2",
                          "native"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "englishLevel": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "none",
