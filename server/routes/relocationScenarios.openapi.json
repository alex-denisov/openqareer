                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "georgiaPensionParticipant": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "uaeNational": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              }
            },
