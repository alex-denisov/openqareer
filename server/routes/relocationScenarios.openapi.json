              "DE",
              "CY",
              "RS",
              "AE",
              "GE",
              "RU"
            ]
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "householdSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "incomeMode": {
            "type": "string",
            "enum": [
              "local_employment",
              "remote_employment",
              "self_employed"
            ]
          },
          "grossAnnualIncome": {
            "$ref": "#/components/schemas/ScenarioInput/$defs/__schema0"
          },
          "confirmedNetMonthly": {
            "$ref": "#/components/schemas/ScenarioInput/$defs/__schema1"
          },
          "scenarioId": {
            "type": "string",
            "enum": [
              "domestic_market",
              "employer_sponsorship",
              "job_seeker_visa",
              "digital_nomad",
              "simple_mobility"
