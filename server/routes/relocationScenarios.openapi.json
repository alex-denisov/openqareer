                  "$ref": "#/components/schemas/ScenarioInput/$defs/__schema10"
                }
              },
              "currentCountryCode": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "hasJobOffer": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "approvedEmployerSponsor": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "occupationEligible": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "occupationGoingRateMet": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "recognizedDegreeCountryCodes": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScenarioInput/$defs/__schema11"
                }
              },
              "completedFormalQualification": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "blueCardExceptionEligible": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "isItProfessional": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "hasBachelorDegree": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "worksRemotelyForForeignEmployer": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "hasPrivateHealthInsurance": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "remoteMonthlyIncomeIsNet": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema9"
              },
              "remoteMonthlyIncome": {
                "type": "object",
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/ScenarioInput/$defs/__schema0"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              },
              "hasLocalWorkAuthorizationCountryCodes": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScenarioInput/$defs/__schema12"
                }
              },
              "minimumMonthlyFunds": {
                "type": "object",
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/ScenarioInput/$defs/__schema0"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              },
              "meetsLanguageRequirementsByCountry": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "jobSeekerCategoryEligibleByCountry": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "recentTopUniversityGraduateWithinYearsByCountry": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                }
              },
              "financialGuaranteeSatisfiedByCountry": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScenarioInput/$defs/__schema13"
                }
              },
              "relevantExperienceYearsByWindow": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[0-9]{1,2}$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                }
              },
              "shortTermWorkExceptionByCountry": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "germanyOpportunityCard": {
                "type": "object",
                "properties": {
                  "qualificationRecognition": {
                    "type": "string",
                    "enum": [
                      "fully",
                      "partially",
                      "not-recognized",
                      "unknown"
                    ]
                  },
                  "shortageOccupation": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "experienceYearsLastFive": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
