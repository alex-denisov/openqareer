{
  "openapi": "3.1.0",
  "info": {
    "title": "Candidate relocation scenarios B468",
    "version": "1.0.0",
    "description": "Additive v1 surface; runtime input schema shared/relocationScenario.ts is authoritative. Estimates retain source, city, household, period, payer and observation date. Candidate-only encrypted storage; unknown figures are not zero."
  },
  "security": [
    {
      "candidateBearer": []
    }
  ],
  "paths": {
    "/api/v1/candidate/relocation-scenarios": {
      "post": {
        "summary": "Save an immutable server-calculated relocation scenario",
        "description": "Active relocation consent required. Same key and same parsed input replays the original snapshot without extending history; different input with same key returns409. At most50 saved scenarios per candidate. Body limit32768bytes. Conditional source URL rule is enforced by the runtime schema: source_quote requires URL. No provider calls are performed.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate-owned saved scenario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SavedScenario"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Candidate-owned saved scenario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SavedScenario"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "401": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "403": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "409": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "429": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "503": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          }
        }
      },
      "get": {
        "summary": "List own saved scenarios",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "data.items (SavedScenario[]) and data.nextOffset (integer|null); private,no-store"
          },
          "400": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "401": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          }
        }
      }
    },
    "/api/v1/candidate/relocation-scenarios/{id}": {
      "get": {
        "summary": "Read own immutable snapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate-owned saved scenario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SavedScenario"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "404": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          }
        }
      },
      "delete": {
        "summary": "Delete own scenario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Existing same-origin cookie mutation policy applies; missing/other-candidate resources return404. All snapshots also cascade on account deletion and are erased on relocation-consent revocation.",
        "responses": {
          "204": {
            "description": "Deleted; empty body"
          },
          "401": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "403": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "404": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          },
          "429": {
            "description": "Standard candidate API error envelope; machine code and retryable flag."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "candidateBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing candidate authentication. Browser sessions use the same authenticated API client and mutation-origin policy."
      }
    },
    "schemas": {
