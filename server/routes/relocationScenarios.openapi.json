                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema2"
              },
              "period": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema3"
              },
              "payer": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema4"
              },
              "kind": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema5"
              },
              "basis": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema6"
              },
              "observedAt": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema7"
              },
              "url": {
                "$ref": "#/components/schemas/ScenarioInput/$defs/__schema8"
              }
            },
            "required": [
              "amount",
              "currency",
              "period",
              "kind",
              "basis",
              "observedAt"
            ],
            "additionalProperties": false
          },
          "__schema2": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "__schema3": {
            "type": "string",
            "enum": [
              "monthly",
              "annual",
              "once"
            ]
          },
          "__schema4": {
            "default": "candidate",
            "type": "string",
            "enum": [
              "candidate",
              "employer",
              "included"
            ]
          },
          "__schema5": {
            "type": "string",
            "enum": [
              "candidate_estimate",
              "source_quote"
            ]
          },
          "__schema6": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "__schema7": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "__schema8": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "pattern": "^https:\\/\\/.*"
          },
          "__schema9": {
            "type": "boolean"
          },
          "__schema10": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "__schema11": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "__schema12": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "__schema13": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
