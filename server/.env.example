OPENQAREER_HOST=127.0.0.1
OPENQAREER_PORT=3210
OPENQAREER_OPENAI_API_KEY=replace-with-openqareer-project-key
OPENQAREER_ANTHROPIC_API_KEY=
OPENQAREER_FIREWORKS_API_KEY=
OPENQAREER_OPENROUTER_API_KEY=replace-with-openqareer-project-key
OPENQAREER_GEMINI_API_KEY=
# Тоннель Cloudflare AI Gateway. Gemini ходит только через него (решение
# владельца 2026-09-02): прямой вызов до gemini-3.7-flash с прод-хоста не
# доходит вовсе. Без обоих идентификаторов Gemini честно считается
# ненастроенным, даже если ключ задан. Шлюз аккаунта — `openqareer`,
# аутентифицированный: токен обязателен.
OPENQAREER_CF_AI_GATEWAY_ACCOUNT_ID=
OPENQAREER_CF_AI_GATEWAY_ID=
OPENQAREER_CF_AI_GATEWAY_TOKEN=
OPENQAREER_GROQ_API_KEY=
OPENQAREER_MISTRAL_API_KEY=
OPENQAREER_CEREBRAS_API_KEY=
OPENQAREER_COHERE_API_KEY=
OPENQAREER_YANDEX_API_KEY=
OPENQAREER_YANDEX_FOLDER_ID=
# Дополнительные eTerapy-equivalent OpenAI-compatible провайдеры. Пустое
# значение оставляет коннектор видимым в каталоге, но не настроенным.
OPENQAREER_KILO_CODE_AI_API_KEY=
OPENQAREER_NVIDIA_NIM_API_KEY=
OPENQAREER_OPENCODE_ZEN_AI_API_KEY=
OPENQAREER_TOKENROUTER_API_KEY=
OPENQAREER_SAMBANOVA_CLOUD_API_KEY=
OPENQAREER_POLLINATIONS_AI_API_KEY=
OPENQAREER_HUGGINGFACE_HUB_API_KEY=
OPENQAREER_PREVIEW_API_TOKEN=replace-with-at-least-32-random-characters
OPENQAREER_DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
OPENQAREER_DATABASE_PATH=data/openqareer.db
OPENQAREER_AI_MODEL=gpt-5.6-luna
OPENQAREER_PERSONAL_AI_PROVIDER=openai
OPENQAREER_PERSONAL_AI_MODEL=gpt-5.6-luna
OPENQAREER_SYNTHETIC_AI_PROVIDER=gemini
OPENQAREER_SYNTHETIC_AI_MODEL=gemini-3.8-flash
# Второй приоритет и дальше — по порядку, `провайдер:модель` через запятую.
# Без этой строки порядок задал бы реестр, и вторым стал бы OpenAI (B183).
OPENQAREER_SYNTHETIC_AI_FALLBACK=openrouter:openrouter/free
OPENQAREER_LOG_LEVEL=info
OPENQAREER_ADMIN_USERNAME=replace-with-admin-username
OPENQAREER_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
OPENQAREER_TEST_CANDIDATE_USERNAME=replace-with-test-candidate-username
OPENQAREER_TEST_CANDIDATE_PASSWORD=replace-with-at-least-16-random-characters
# Подключение площадок кандидата (B092). Площадка настраивается всеми тремя
# значениями сразу или не настраивается вовсе: пустые значения означают, что
# подключение честно показывается недоступным. Redirect URI должен точно
# совпадать с https://<host>/api/v1/connectors/<linkedin|hh>/callback и
# совпадать с зарегистрированным developer app. Секреты хранятся только вне
# репозитория.
OPENQAREER_LINKEDIN_CLIENT_ID=
OPENQAREER_LINKEDIN_CLIENT_SECRET=
OPENQAREER_LINKEDIN_REDIRECT_URI=
OPENQAREER_HH_CLIENT_ID=
OPENQAREER_HH_CLIENT_SECRET=
OPENQAREER_HH_REDIRECT_URI=
# Account recovery (B132). Use only the dedicated openqareer.com Resend key;
# never reuse another product's unscoped RESEND_API_KEY.
OPENQAREER_RESEND_API_KEY=
OPENQAREER_ACCOUNT_EMAIL_FROM="openqareer <noreply@openqareer.com>"
OPENQAREER_PUBLIC_URL=https://openqareer.com
