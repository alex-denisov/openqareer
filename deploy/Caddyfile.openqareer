{
	servers :443 {
		# PRB-041 (03.11): HTTP/2 with keep-alive. INC-004 pinned HTTP/1.1 and closed
		# every connection for the Russia-to-AWS route of August; Russia now goes
		# through the relay, which has its own TLS. Here that pin cost each of the
		# ~50 boot requests a fresh TLS handshake (~250 ms) behind a 6-connection
		# cap, and the «Отклики» click queued behind them. No h3: QUIC broke on the
		# Russian route in INC-004, and h2 already removes the per-request handshake.
		protocols h1 h2
		# Russian-reachable relay (deploy/bootstrap-ru-relay.sh): its X-Forwarded-For
		# names the real client, everyone else's is ignored.
		trusted_proxies static 107.172.153.202/32
	}
}

openqareer.com {
	encode gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable" {
		match status 2xx
	}
	header @assets Cache-Control "no-store" {
		match status 4xx
	}

	@health path /health
	header @health Cache-Control "no-store"

	@api path /api/*
	header @api Cache-Control "no-store"

	@document path / /index.html
	header @document Cache-Control "no-cache"

	@spa {
		not path /api/* /assets/* /health /index.html
	}
	header @spa Cache-Control "no-cache"

	# INC-018 — there used to be `rewrite @spa /index.html` here. It rewrote
	# every path outside the four exceptions above *before* proxying, so the
	# application never saw the real path: `/robots.txt`, `/llms.txt`,
	# `/favicon.svg`, `/og-cover.jpg`, `/apple-touch-icon.png` and `/admin`
	# all arrived upstream as `/index.html` and came back as the SPA document.
	# That is why the same artifact serves them correctly on localhost and not
	# here. The rewrite was redundant as well as harmful: the application's own
	# not-found handler already answers any unknown GET with the right entry
	# document, and since B089 that is a per-surface choice this proxy must not
	# make on its behalf.

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://tiles.openfreemap.org https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src blob: https://mc.yandex.ru https://mc.yandex.com; img-src 'self' data: blob: https://tiles.openfreemap.org https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; object-src 'none'; script-src 'self' blob: 'wasm-unsafe-eval' https://mc.yandex.ru https://yastatic.net https://www.googletagmanager.com; style-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-OpenQareer-Origin "eu-1"
		-Server
	}

	# Hashed build files come from disk, not through node: during an event-loop
	# stall in the application an 865-byte chunk waited 2 s for its first byte
	# (prod 02.11). `previous` keeps an old hash alive through one release
	# switch; a file in neither falls through to the application, which answers
	# 404 exactly as before.
	@assetFile {
		path /assets/*
		file {
			root /srv/openqareer
			try_files /current{path} /previous{path}
		}
	}
	handle @assetFile {
		root * /srv/openqareer
		rewrite * {http.matchers.file.relative}
		file_server
	}

	reverse_proxy 127.0.0.1:3210 {
		# One hop, the real client: rate limits must not merge every relayed user.
		header_up X-Forwarded-For {client_ip}
	}
}

# 03.11: typed and linked www addresses had no record at all. One 301 to the
# apex keeps the path and query, so the old link lands on the same page.
www.openqareer.com {
	redir https://openqareer.com{uri} permanent
}
