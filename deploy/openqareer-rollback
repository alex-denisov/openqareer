#!/usr/bin/env bash
set -Eeuo pipefail

readonly RELEASE_ROOT="${OPENQAREER_RELEASE_ROOT:-/srv/openqareer}"
readonly SLOTS_LIB="${OPENQAREER_SLOTS_LIB:-/usr/local/lib/openqareer/openqareer-slots.sh}"
readonly MAINTENANCE_SERVICE=openqareer-maintenance.service
readonly MECHANICS_SERVICE=openqareer-vacancy-mechanics.service

fail() {
  printf 'openqareer-rollback: %s\n' "$1" >&2
  exit 1
}

assert_maintenance_stop_timeout() {
  local timeout_value timeout_number
  timeout_value="$(systemctl show "$MAINTENANCE_SERVICE" -p TimeoutStopUSec --value)"
  case "$timeout_value" in
    infinity)
      return 0
      ;;
    *min)
      timeout_number="${timeout_value%min}"
      [[ "$timeout_number" =~ ^[0-9]+$ && "$timeout_number" -ge 5 ]] && return 0
      ;;
    *s)
      timeout_number="${timeout_value%s}"
      [[ "$timeout_number" =~ ^[0-9]+$ && "$timeout_number" -ge 300 ]] && return 0
      ;;
  esac
  fail "maintenance service TimeoutStopSec must be at least 5 minutes (effective: ${timeout_value:-unknown})"
}

# shellcheck source=openqareer-slots.sh
source "$SLOTS_LIB"

[[ "$(id -un)" == "openqareer-deploy" ]] ||
  fail "must run as openqareer-deploy"

assert_maintenance_stop_timeout

exec 9>"$RELEASE_ROOT/.deploy.lock"
flock -n 9 || fail "another deploy or rollback is in progress"

next_link=""
cleanup() {
  [[ -z "$next_link" ]] || rm -f -- "$next_link"
}
trap cleanup EXIT

atomic_link() {
  local -r target="$1"
  local -r link_name="$2"
  next_link="$RELEASE_ROOT/.${link_name}.next.$$"
  rm -f -- "$next_link"
  ln -s "$target" "$next_link"
  mv -Tf "$next_link" "$RELEASE_ROOT/$link_name"
  next_link=""
}

cd "$RELEASE_ROOT"
current_target="$(readlink current 2>/dev/null || true)"
previous_target="$(readlink previous 2>/dev/null || true)"
[[ -n "$current_target" && -n "$previous_target" ]] ||
  fail "current/previous release is unavailable"
[[ -d "$previous_target" ]] || fail "previous release directory is missing"

expected="$(basename "$previous_target")"
live_port="$(active_port)"
back_port="$(other_port "$live_port")"

# B705: если прежний релиз ещё работает на свободном порту, возврат мгновенный —
# одно переключение Caddy. Иначе он поднимается рядом с текущим, и трафик
# уходит на него только после ответа /health; сайт всё это время отвечает.
if slot_is_active "$back_port" && [[ "$(slot_health "$back_port")" == "$expected" ]]; then
  mode=instant
else
  mode=warm
  start_slot "$back_port" "$previous_target" "$expected" ||
    fail "rollback health failed on port $back_port; current release still serving"
fi

atomic_link "$previous_target" current
atomic_link "$current_target" previous
if ! switch_upstream "$back_port"; then
  atomic_link "$current_target" current
  atomic_link "$previous_target" previous
  [[ "$mode" == "instant" ]] || stop_slot "$back_port"
  fail "proxy switch to port $back_port failed; current release still serving"
fi
retire_slot "$back_port" "$live_port"

if ! sudo -n /usr/bin/systemctl restart "$MAINTENANCE_SERVICE" ||
  ! systemctl is-active --quiet "$MAINTENANCE_SERVICE"; then
  fail "maintenance service is not active after rollback restart; check journalctl -u $MAINTENANCE_SERVICE"
fi

if systemctl cat "$MECHANICS_SERVICE" >/dev/null 2>&1; then
  if ! sudo -n /usr/bin/systemctl restart "$MECHANICS_SERVICE" ||
    ! systemctl is-active --quiet "$MECHANICS_SERVICE"; then
    fail "vacancy mechanics service is not active after rollback restart; check journalctl -u $MECHANICS_SERVICE"
  fi
fi

printf 'rollback=%s previous=%s port=%s mode=%s health=ok\n' \
  "$previous_target" "$current_target" "$back_port" "$mode"
