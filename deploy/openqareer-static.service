[Unit]
Description=OpenQareer immutable static release server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openqareer-deploy
Group=openqareer-deploy
EnvironmentFile=/etc/openqareer-static.env
ExecStart=/usr/bin/busybox httpd -f -p ${OPENQAREER_LISTEN} -h /srv/openqareer/current -c /etc/openqareer-httpd.conf
Restart=on-failure
RestartSec=2s
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/openqareer
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
