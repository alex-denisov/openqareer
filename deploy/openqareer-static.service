[Unit]
Description=OpenQareer application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openqareer-deploy
Group=openqareer-deploy
Environment=NODE_ENV=production
Environment=OPENQAREER_HOST=127.0.0.1
Environment=OPENQAREER_PORT=3210
Environment=OPENQAREER_DATABASE_PATH=/var/lib/openqareer/openqareer.db
Environment=NODE_OPTIONS=--max-old-space-size=1536
# B373: вход в LinkedIn в браузере сервера запускает Chromium из HTTP-процесса
# (как у openqareer-maintenance, ставит openqareer-browser-install).
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/openqareer/browser/ms-playwright
Environment=OPENQAREER_PLAYWRIGHT_MODULE=/opt/openqareer/browser/node_modules/playwright-core/index.mjs
EnvironmentFile=/etc/openqareer/openqareer.env
ExecStart=/opt/openqareer/node-v24.14.1-linux-x64/bin/node /srv/openqareer/current/server.mjs
Restart=on-failure
RestartSec=2s
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/openqareer
ReadWritePaths=/var/lib/openqareer
RestrictAddressFamilies=AF_INET AF_INET6
# Песочнице Chromium нужны пользовательские, PID- и сетевые пространства имён.
RestrictNamespaces=user pid net
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
