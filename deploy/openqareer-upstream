#!/usr/bin/env bash
# B705: переключает Caddy на экземпляр приложения 3210 или 3211.
# Запускается через sudo от openqareer-deploy с одним из двух точных аргументов.
# Пишет сниппет, проверяет весь Caddyfile, делает graceful reload (открытые
# соединения дорабатывают на прежнем upstream); при ошибке возвращает сниппет.
set -Eeuo pipefail

if [[ "$(id -u)" == "0" ]]; then
  readonly SNIPPET=/etc/caddy/openqareer-upstream.caddy
  readonly CADDYFILE=/etc/caddy/Caddyfile
else
  # Только для тестов: под root переопределения не читаются.
  readonly SNIPPET="${OPENQAREER_UPSTREAM_FILE:?}"
  readonly CADDYFILE="${OPENQAREER_CADDYFILE:?}"
fi

fail() {
  printf 'openqareer-upstream: %s\n' "$1" >&2
  exit 1
}

port="${1:-}"
[[ "$port" == "3210" || "$port" == "3211" ]] || fail "port must be 3210 or 3211"

wanted="to 127.0.0.1:$port"
if [[ -f "$SNIPPET" && "$(cat "$SNIPPET")" == "$wanted" ]]; then
  printf 'upstream=%s unchanged\n' "$port"
  exit 0
fi

backup="$(mktemp)"
next="$(mktemp "$(dirname "$SNIPPET")/.openqareer-upstream.XXXXXX")"
had_snippet=0
restore() {
  if [[ "$had_snippet" == "1" ]]; then
    cp -- "$backup" "$SNIPPET"
  else
    rm -f -- "$SNIPPET"
  fi
}
trap 'rm -f -- "$backup" "$next"' EXIT
if [[ -f "$SNIPPET" ]]; then
  cp -- "$SNIPPET" "$backup"
  had_snippet=1
fi

printf '%s\n' "$wanted" > "$next"
chmod 0644 "$next"
mv -f -- "$next" "$SNIPPET"

if ! caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
  restore
  fail "Caddyfile with upstream $port does not validate; previous upstream kept"
fi
if ! systemctl reload caddy; then
  restore
  systemctl reload caddy || true
  fail "caddy reload failed; previous upstream restored"
fi
printf 'upstream=%s switched\n' "$port"
