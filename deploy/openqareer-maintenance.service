[Unit]
Description=OpenQareer vacancy pool maintenance (B230)
After=network-online.target openqareer-static.service
Wants=network-online.target

[Service]
Type=simple
User=openqareer-deploy
Group=openqareer-deploy
Environment=NODE_ENV=production
Environment=OPENQAREER_DATABASE_PATH=/var/lib/openqareer/openqareer.db
# Волна опросов обязана жить в партиях, а не в целом пуле. B649-6 (15.11):
# при пуле ~1,69 млн 640 МБ давали heap OOM ~4 раза в сутки (11 за 48 ч),
# GC у потолка — часть стоянок цикла. 1536 — в пределах MemoryMax=5G.
Environment=NODE_OPTIONS=--max-old-space-size=1536
# B313: Chromium для исполнителя пула LinkedIn ставится openqareer-browser-install.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/openqareer/browser/ms-playwright
Environment=OPENQAREER_PLAYWRIGHT_MODULE=/opt/openqareer/browser/node_modules/playwright-core/index.mjs
EnvironmentFile=/etc/openqareer/openqareer.env
ExecStart=/opt/openqareer/node-v24.14.1-linux-x64/bin/node /srv/openqareer/current/maintenance.mjs
Restart=on-failure
RestartSec=30s
# SIGTERM ждёт restore/текущую волну (журнал: maintenance-shutdown-started →
# -finished). Restore существующего production pool занимает до ~3 минут.
TimeoutStopSec=300s
KillMode=mixed
UMask=0027

# Прод 05.11: при 2G страничный кэш базы вытеснялся, и один полный проход читал
# диск 20-46 с вместо 3 с. Кучу отдельно держит --max-old-space-size.
MemoryMax=5G
MemorySwapMax=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=30

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/openqareer
ReadWritePaths=/var/lib/openqareer
RestrictAddressFamilies=AF_INET AF_INET6
# Песочнице Chromium нужны пользовательские, PID- и сетевые пространства имён.
RestrictNamespaces=user pid net
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
