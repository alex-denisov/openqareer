[Unit]
Description=OpenQareer vacancy pool maintenance (B230)
After=network-online.target openqareer-static.service
Wants=network-online.target

[Service]
Type=simple
User=openqareer-deploy
Group=openqareer-deploy
Environment=NODE_ENV=production
Environment=OPENQAREER_DATABASE_PATH=/var/lib/openqareer/openqareer.db
# Куча вдвое-втрое меньше, чем у HTTP: волна опросов обязана жить в партиях,
# а не в целом пуле. Превышение — это ошибка кода, и юнит её показывает.
Environment=NODE_OPTIONS=--max-old-space-size=640
EnvironmentFile=/etc/openqareer/openqareer.env
ExecStart=/opt/openqareer/node-v24.14.1-linux-x64/bin/node /srv/openqareer/current/maintenance.mjs
Restart=on-failure
RestartSec=30s
# SIGTERM ждёт текущую волну (журнал: maintenance-shutdown-started → -finished).
TimeoutStopSec=120s
KillMode=mixed
UMask=0027

MemoryMax=900M
MemorySwapMax=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=30

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/openqareer
ReadWritePaths=/var/lib/openqareer
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
