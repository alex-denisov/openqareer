{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenQareer",
  "version": "1.0.0",
  "identifier": "com.openqareer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "scripts/download-sing-box-sidecars.sh && npm run build && node scripts/build-update-manifest.mjs --check-signing",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenQareer",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "externalBin": ["binaries/sing-box"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NTQ3RTExNTQwQzUyNjkKUldScFVneFVFWDVVaDhaN0tBUjVIVVBqcEFrWnN3Y0RCT01jbEtpeGd1NzMxdE03Z3Nqa1ZUbEMK",
      "endpoints": ["https://openqareer.com/desktop/latest.json"]
    }
  }
}
